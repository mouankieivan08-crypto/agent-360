# Copie ce fichier en .env puis remplis au minimum ANTHROPIC_API_KEY.

# --- Claude (obligatoire) : https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Modèle : claude-opus-5-5 (défaut, le plus fin), claude-sonnet-5-5 (2x moins cher), claude-haiku-5-5 (le moins cher)
CLAUDE_MODEL=claude-opus-5-5
# Profondeur de réflexion : low | medium | high
CLAUDE_EFFORT=medium
# Recherche web pour trouver des prospects (facturée en plus par Anthropic)
WEB_SEARCH=true
WEB_SEARCH_COUNTRY=CG
WEB_SEARCH_CITY=Brazzaville

# --- Toi et ton business
AGENT_NAME=Ndeko
# Ton prénom : l'agent t'appellera comme ça
OWNER_NAME=
BUSINESS_NAME=mon agence
# Vide = tu parles à l'agent dans la discussion « Moi (Vous) » de ton WhatsApp.
# Si l'agent tourne sur un 2e numéro, mets ici TON numéro perso (ex. 242061234567).
OWNER_NUMBERS=
DEFAULT_COUNTRY_CODE=242
TIMEZONE=Africa/Brazzaville
CURRENCY=FCFA

# --- Objectif de départ (modifiable ensuite en parlant à l'agent)
GOAL_AMOUNT=5000000
GOAL_START=2026-01-01
GOAL_DEADLINE=2026-12-31

# --- Notes vocales (optionnel) : clé gratuite sur https://console.groq.com
STT_API_KEY=
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_MODEL=whisper-large-v3-turbo

# --- Garde-fous de prospection (protègent ton numéro du bannissement)
# Numéro neuf : commence à 10-15/jour la 1re semaine, puis monte progressivement.
DAILY_SEND_LIMIT=25
MIN_GAP_SECONDS=120
MAX_GAP_SECONDS=420
SEND_WINDOW_START=08:30
SEND_WINDOW_END=17:30
# 1 = lundi ... 7 = dimanche
SEND_DAYS=1,2,3,4,5,6

# --- Rituels du coach (heure locale)
MORNING_BRIEF=07:45
EVENING_CHECKIN=19:30
WEEKLY_REVIEW_DAY=7
WEEKLY_REVIEW=18:00

# --- WhatsApp
WA_AUTH_DIR=./auth
# Renseigne ton numéro pour te connecter avec un code à 8 caractères au lieu du QR code
WA_PAIRING_NUMBER=
DATA_DIR=./data
